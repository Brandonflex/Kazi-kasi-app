# Local Next.js dev server proxies same-origin /api requests to FastAPI.
KAZIKASI_API_SERVER_URL=http://127.0.0.1:8001

# Optional: call a public FastAPI origin directly instead of using the proxy.
# In Vercel, set this to the separately deployed API origin only if you have
# configured that API's CORS allowlist for your frontend domain.
NEXT_PUBLIC_API_URL=
