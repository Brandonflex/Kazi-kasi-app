# Every variable the product reads, with no values. Copy this list into
# Vercel → Settings → Environment Variables, one row per variable.
# See docs/credentials.md for what each one does and how to rotate it.

# --- sessions (require all three; see /auth/ready) -------------------------
KAZIKASI_SECRET=
KAZIKASI_DEMO=0
KAZIKASI_BASE_URL=https://kazi-kasi-app.vercel.app

# --- sign-in (each provider needs both halves) ----------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- storage (either one; DATABASE_URL is the real answer) ----------------
DATABASE_URL=
KAZIKASI_BUNDLE=

# --- delivery (one transport is enough to start) --------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- the scheduled tick ---------------------------------------------------
CRON_SECRET=
# Only for testing delivery against your own number on the demo corpus.
KAZIKASI_ALLOW_SYNTHETIC_SEND=
