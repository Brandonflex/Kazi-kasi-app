# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
KAZIKASI_SECRET_KEY=
APP_ENV=production
# Prefer a managed PostgreSQL URL for production durability.
DATABASE_URL=postgresql://user:password@host:5432/kazikasi
KAZIKASI_CORS_ORIGINS=https://kazi-kasi-app.vercel.app
ACCESS_TOKEN_EXPIRE_MINUTES=60
